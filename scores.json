name: Fetch Live Scores

on:
  schedule:
    - cron: '*/2 * * * *'
  workflow_dispatch:

jobs:
  fetch:
    runs-on: ubuntu-latest
    permissions:
      contents: write

    steps:
      - uses: actions/checkout@v5

      - name: Install dependencies
        run: pip install cairosvg requests --quiet --break-system-packages

      - name: Fetch scores and generate preview
        run: |
          python3 << 'PYEOF'
          import json, sys, os, requests
          from datetime import datetime, timedelta, timezone

          MANAGERS = [
            {"name": "Brian",   "teams": ["Portugal","United States","Norway","Tunisia"]},
            {"name": "Robbie",  "teams": ["England","Uruguay","Ecuador","Paraguay"]},
            {"name": "Abe",     "teams": ["Brazil","Senegal","Austria","South Africa"]},
            {"name": "Reed",    "teams": ["Mexico","Morocco","Sweden","Egypt"]},
            {"name": "Keo",     "teams": ["Germany","Croatia","Australia","Qatar"]},
            {"name": "Jason",   "teams": ["Netherlands","Colombia","South Korea","Scotland"]},
            {"name": "Ray",     "teams": ["Belgium","Japan","Czech Republic","Algeria"]},
            {"name": "Danny",   "teams": ["Spain","Iran","Panama","DR Congo"]},
            {"name": "Brandon", "teams": ["France","Turkey","Canada","Saudi Arabia"]},
            {"name": "Dan",     "teams": ["Argentina","Switzerland","Ivory Coast","Uzbekistan"]},
          ]

          NAME_MAP = {
            "Bosnia & Herzegovina": "Bosnia and Herzegovina",
            "Bosnia-Herzegovina": "Bosnia and Herzegovina",
            "USA": "United States", "United States": "United States",
            "Korea Republic": "South Korea", "South Korea": "South Korea",
            "Curacao": "Curaçao", "Curaçao": "Curaçao",
            "Türkiye": "Turkey", "Turkiye": "Turkey",
            "Ivory Coast": "Ivory Coast", "Côte d'Ivoire": "Ivory Coast",
            "DR Congo": "DR Congo", "Congo DR": "DR Congo",
            "Czechia": "Czech Republic", "Czech Republic": "Czech Republic",
            "Cape Verde Islands": "Cape Verde", "Cape Verde": "Cape Verde",
          }
          def norm(n): return NAME_MAP.get(n, n)

          # ── Fetch from ESPN per-day (range queries are unreliable) ──────────
          start = datetime(2026, 6, 11, tzinfo=timezone.utc)
          today = datetime.now(timezone.utc)
          cutoff = min(today, datetime(2026, 6, 28, tzinfo=timezone.utc))

          all_events = {}
          d = start
          while d <= cutoff:
            date_str = d.strftime('%Y%m%d')
            try:
              url = f"https://site.api.espn.com/apis/site/v2/sports/soccer/fifa.world/scoreboard?dates={date_str}&limit=20"
              r = requests.get(url, timeout=10,
                headers={"User-Agent": "Mozilla/5.0 (compatible; bot/1.0)"})
              r.raise_for_status()
              data = r.json()
              for e in data.get("events", []):
                if e.get("id") not in all_events:
                  all_events[e["id"]] = e
            except Exception as ex:
              print(f"ESPN {date_str} failed: {ex}")
            d += timedelta(days=1)

          events = list(all_events.values())
          print(f"ESPN: {len(events)} total events fetched")

          matches = []
          for e in events:
            comp = (e.get("competitions") or [{}])[0]
            st = ((comp.get("status") or e.get("status") or {}).get("type") or {})
            state_ = st.get("state")
            if state_ != "post":
              continue  # only completed matches
            competitors = comp.get("competitors", [])
            home = next((c for c in competitors if c.get("homeAway") == "home"), {})
            away = next((c for c in competitors if c.get("homeAway") == "away"), {})
            t1 = norm(home.get("team", {}).get("displayName", ""))
            t2 = norm(away.get("team", {}).get("displayName", ""))
            if not t1 or not t2: continue
            s1 = int(home.get("score") or 0)
            s2 = int(away.get("score") or 0)
            matches.append({
              "home_team": t1, "away_team": t2,
              "home_score": s1, "away_score": s2,
              "finished": "TRUE", "status": "FT",
              "date": e.get("date", "")
            })

          if not matches:
            print("No completed matches from ESPN — keeping existing scores.json")
            sys.exit(0)

          print(f"Writing {len(matches)} completed matches to scores.json")
          with open("scores.json", "w") as f:
            json.dump(matches, f)

          # ── Compute standings ────────────────────────────────────────────────
          team_pts, team_gd = {}, {}
          for m in matches:
            t1, t2 = m["home_team"], m["away_team"]
            s1, s2 = int(m["home_score"]), int(m["away_score"])
            team_pts.setdefault(t1, 0); team_pts.setdefault(t2, 0)
            team_gd.setdefault(t1, 0);  team_gd.setdefault(t2, 0)
            team_gd[t1] += s1-s2; team_gd[t2] += s2-s1
            if s1 > s2:    team_pts[t1] += 3
            elif s2 > s1:  team_pts[t2] += 3
            else:           team_pts[t1] += 1; team_pts[t2] += 1

          standings = []
          for m in MANAGERS:
            pts = sum(team_pts.get(t, 0) for t in m["teams"])
            gd  = sum(team_gd.get(t, 0)  for t in m["teams"])
            standings.append({"name": m["name"].upper(), "teams": m["teams"], "pts": pts, "gd": gd})
          standings.sort(key=lambda x: (-x["pts"], -x["gd"]))

          # ── Generate preview image ───────────────────────────────────────────
          rank_colors = ["#FAC775","#D3D1C7","#F5C4B3"]
          rows = ""
          for i, m in enumerate(standings[:5]):
            y = 258 + i * 58
            rc = rank_colors[i] if i < 3 else "rgba(255,255,255,0.35)"
            nc = "white" if i < 3 else "rgba(255,255,255,0.65)"
            pts_str = str(m["pts"]) if m["pts"] > 0 else "—"
            teams_str = " · ".join(m["teams"])
            bg = 'fill="rgba(250,199,117,0.08)"' if i == 0 else 'fill="rgba(255,255,255,0.03)"'
            rows += f'''
              <rect x="60" y="{y}" width="1080" height="52" rx="8" {bg}/>
              <rect x="60" y="{y}" width="4" height="52" rx="2" fill="{rc}"/>
              <text x="90"   y="{y+34}" font-family="Arial Black,Arial,sans-serif" font-size="22" font-weight="900" fill="{rc}">{i+1}</text>
              <text x="130"  y="{y+34}" font-family="Arial Black,Arial,sans-serif" font-size="26" font-weight="900" fill="{nc}">{m["name"]}</text>
              <text x="360"  y="{y+32}" font-family="Arial,sans-serif" font-size="15" fill="rgba(255,255,255,0.28)">{teams_str}</text>
              <text x="1110" y="{y+34}" font-family="Arial Black,Arial,sans-serif" font-size="26" font-weight="900" fill="#1D9E75" text-anchor="end">{pts_str}</text>'''

          svg = f"""<svg width="1200" height="630" xmlns="http://www.w3.org/2000/svg">
            <defs><linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#0a1a10"/>
              <stop offset="100%" stop-color="#0f2a18"/>
            </linearGradient></defs>
            <rect width="1200" height="630" fill="url(#bg)"/>
            <rect width="1200" height="5" fill="#1D9E75"/>
            <text x="60" y="90"  font-family="Arial Black,Arial,sans-serif" font-size="15" font-weight="900" fill="#1D9E75" letter-spacing="5">2026 FIFA WORLD CUP</text>
            <text x="60" y="155" font-family="Arial Black,Arial,sans-serif" font-size="62" font-weight="900" fill="white">Fantasy Draft</text>
            <text x="60" y="195" font-family="Arial,sans-serif" font-size="20" fill="rgba(255,255,255,0.4)">10 managers · 4 teams each · Live results</text>
            <rect x="60" y="218" width="1080" height="1" fill="rgba(255,255,255,0.1)"/>
            <text x="60"   y="248" font-family="Arial,sans-serif" font-size="12" font-weight="700" fill="rgba(255,255,255,0.3)" letter-spacing="3">RANK</text>
            <text x="130"  y="248" font-family="Arial,sans-serif" font-size="12" font-weight="700" fill="rgba(255,255,255,0.3)" letter-spacing="3">MANAGER</text>
            <text x="1090" y="248" font-family="Arial,sans-serif" font-size="12" font-weight="700" fill="rgba(255,255,255,0.3)" letter-spacing="3" text-anchor="end">PTS</text>
            {rows}
            <text x="60"   y="578" font-family="Arial,sans-serif" font-size="14" fill="rgba(255,255,255,0.2)">+ {len(standings)-5} more managers · Visit link for live standings →</text>
            <text x="1140" y="615" font-family="Arial,sans-serif" font-size="13" fill="rgba(255,255,255,0.2)" text-anchor="end">reedjohnston.github.io/wc2026-fantasy</text>
            <text x="1120" y="175" font-family="Arial,sans-serif" font-size="130" fill="rgba(29,158,117,0.07)" text-anchor="middle">⚽</text>
          </svg>"""

          with open("preview.svg", "w") as f:
            f.write(svg)

          import cairosvg
          cairosvg.svg2png(url="preview.svg", write_to="preview.png", output_width=1200, output_height=630)
          print("preview.png generated")
          PYEOF

      - name: Commit and push if changed
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add scores.json preview.png
          git diff --staged --quiet || git commit -m "chore: update scores + preview $(date -u +'%H:%M UTC')"
          git push
